# ============================================
# AutoTreehole Daily - 环境变量模板
# 复制到 .env 后填入真实值，.env 已被 .gitignore 忽略
# ============================================

# —— LLM（minimax-m3）——
# OpenAI 兼容协议
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=sk-cp-xxx-your-real-key
MINIMAX_MODEL=MiniMax-M3

# —— 邮件（QQ 邮箱）——
# 用于每日 8:00 摘要推送 + 失败告警
QQ_EMAIL=2430347329@qq.com
QQ_EMAIL_AUTH_CODE=your-smtp-auth-code
EMAIL_TO=2430347329@qq.com

# —— 应用配置 ——
# 后端监听端口（仅本机，nginx 反代）
APP_PORT=8001
APP_HOST=127.0.0.1
# 时区
APP_TZ=Asia/Shanghai
# 站点基础 URL（用于邮件里附带链接）
SITE_BASE_URL=https://autotreehole.cn/daily

# —— 数据保留（天）——
# 超过保留天数的内容自动归档 / 删除
TTL_NEWS=90
TTL_FINANCE_NEWS=14
TTL_SCHOOL=14
TTL_DEALS_DEFAULT=14
# 羊毛默认过期天数（当数据源未给出 expire_date 时）
DEALS_DEFAULT_EXPIRE_DAYS=14

# —— 抓取开关（true / false）——
# 任何模块失败都写入 fetch_logs 并邮件通知
ENABLE_QUANT=true
ENABLE_NEWS=true
ENABLE_ARXIV=true
ENABLE_SCHOOL=true
ENABLE_LEETCODE=true
ENABLE_ENGLISH=true
ENABLE_FINANCE=true
ENABLE_GITHUB=true
ENABLE_DEALS=true

# —— 量化搜索关键词白名单 ——
# 头部 / 颈部量化公司 + 社团
QUANT_KEYWORDS=九坤,幻方,明汯,衍复,锐天,致诚卓远,灵均,Optiver,Jane Street,Two Sigma, Citadel,Jump Trading,DE Shaw,WorldQuant

# —— 站点访问控制 ——
# 当前完全公开
REQUIRE_AUTH=false
# 如开启，下面三个任选一个：
# AUTH_PASSWORD=your-shared-password
# AUTH_IP_WHITELIST=1.2.3.4

# —— 日志级别 ——
LOG_LEVEL=INFO
